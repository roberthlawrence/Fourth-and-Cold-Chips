rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= BOOTSTRAP POWER ADMIN =================
    // Put YOUR exact sign-in Gmail here (lowercase). This is the
    // only email you ever have to hardcode — every other admin is
    // added from the Admins section inside the app.
    function bootstrapPower() {
      return ["roberthlawrence@gmail.com"];
    }
    // =========================================================

    function signedIn() { return request.auth != null; }
    function myEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower() : "";
    }
    function adminDocExists() {
      return exists(/databases/$(database)/documents/config/admins);
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/config/admins).data;
    }
    function isPower() {
      return signedIn() && (
        myEmail() in bootstrapPower()
        || (adminDocExists() && myEmail() in adminDoc().power)
      );
    }
    function isPay() {
      return signedIn() && adminDocExists() && myEmail() in adminDoc().payment;
    }
    function isAdmin() { return isPower() || isPay(); }

    match /config/game {
      allow read: if signedIn();
      allow write: if isPower();
      // payment admins may only start/stop the live raffle
      allow update: if isPower()
        || (isPay() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['raffleLive']));
    }
    match /config/admins {
      allow read: if signedIn();
      allow write: if isPower();
    }
    match /config/bag {
      allow read: if signedIn();
      allow create, update: if signedIn();   // players decrement during draws
      allow delete: if isPower();
    }
    match /config/liveDraw {
      allow read: if signedIn();
      allow write: if isAdmin();             // payment admins run drawings
    }

    // Players are keyed by email (honor-system identity, same trust
    // model as the squares board). 'paid' is admin-only to change.
    match /players/{playerKey} {
      allow read: if signedIn();
      allow create: if isPower()
        || (signedIn() && request.resource.data.paid == 0);
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.paid == resource.data.paid);
      allow delete: if isPower();
    }

    // Chips are owned by email key (honor system among the group).
    // Value and owner can't be edited after the draw; only the bucket
    // placement moves.
    match /chips/{chipId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isPower()
        || (signedIn()
            && request.resource.data.owner == resource.data.owner
            && request.resource.data.value == resource.data.value);
      allow delete: if isAdmin();   // payment admins can release chips to the bag
    }

    match /prizes/{prizeId} {
      allow read: if signedIn();
      allow create, delete: if isPower();
      // payment admins may only record drawing results
      allow update: if isPower()
        || (isPay() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['winners','winnerChipId','winnerName','winnerEmail','winnerValue','drawnAt']));
    }

    match /payments/{paymentId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    match /adminAlerts/{alertId} {
      allow read, write: if isAdmin();
    }
    match /archives/{archiveId} {
      allow read, write: if isPower();
    }
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
