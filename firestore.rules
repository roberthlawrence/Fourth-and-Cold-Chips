rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list identical to ADMIN_EMAILS in firebase-config.js (lowercase).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "you@gmail.com"
        ];
    }
    function signedIn() { return request.auth != null; }

    // Game settings — admin writes only
    match /config/game {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // The bag — players decrement it inside the draw transaction
    match /config/bag {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Players — own doc only; 'paid' can only be changed by admins
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.paid == 0;
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.paid == resource.data.paid);
      allow delete: if isAdmin();
    }

    // Chips — created by their owner during a draw; moved by owner or admin
    match /chips/{chipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || resource.data.owner == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /prizes/{prizeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Append-only audit trail
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
