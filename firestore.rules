rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== EDIT THESE TWO LISTS (lowercase gmail addresses) =====
    // Keep them identical to POWER_ADMIN_EMAILS / PAYMENT_ADMIN_EMAILS
    // in firebase-config.js. Use the exact address you sign in with.
    function isPower() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "you@gmail.com"
        ];
    }
    function isPay() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "paymentadmin1@gmail.com"
        ];
    }
    // ============================================================
    function isAdmin() { return isPower() || isPay(); }
    function signedIn() { return request.auth != null; }

    match /config/game {
      allow read: if signedIn();
      allow write: if isPower();
    }
    match /config/bag {
      allow read: if signedIn();
      allow create, update: if signedIn();   // players decrement during draws
      allow delete: if isPower();
    }
    match /config/liveDraw {
      allow read: if signedIn();
      allow write: if isAdmin();             // payment admins can run drawings
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isPower()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.paid == 0);
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.paid == resource.data.paid);
      allow delete: if isPower();
    }

    match /chips/{chipId} {
      allow read: if signedIn();
      allow create: if isPower()
        || (signedIn() && request.resource.data.owner == request.auth.uid);
      allow update: if isPower() || resource.data.owner == request.auth.uid;
      allow delete: if isPower();
    }

    match /prizes/{prizeId} {
      allow read: if signedIn();
      allow create, delete: if isPower();
      // payment admins may only record drawing results
      allow update: if isPower()
        || (isPay() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['winnerChipId','winnerName','winnerEmail','winnerValue','drawnAt']));
    }

    match /adminAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /archives/{archiveId} {
      allow read, write: if isPower();
    }

    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
